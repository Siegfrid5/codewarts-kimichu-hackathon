# ============================================
# GABAYANI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gabayani
DB_USER=gabayani_user
DB_PASSWORD=gabayani_dev_password

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Authentication ---
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=7d

# --- OpenWeather API ---
OPENWEATHER_API_KEY=your-openweather-api-key

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT_EMAIL=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./config/gee-service-account-key.json

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Semaphore SMS (Philippines) ---
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=GABAYANI
